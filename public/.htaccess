Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS and the canonical non-www host (decision D-005). Skipped on localhost.
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://dubaitowingexperts.com%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.dubaitowingexperts\.com$ [NC]
    RewriteRule ^ https://dubaitowingexperts.com%{REQUEST_URI} [L,R=301]

    # Block dotfiles (except .well-known)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Serve real files directly; everything else goes to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    <FilesMatch "\.(css|js|svg|webp|png|jpg|jpeg|ico|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
</IfModule>
