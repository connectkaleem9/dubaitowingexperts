# Copy to .env (never commit .env). Place .env outside the web root (project root, not public/).
APP_ENV=local            # local | staging | production
APP_DEBUG=true           # MUST be false in production
APP_URL=http://localhost:8000
APP_KEY=                 # 64 random hex chars: php -r "echo bin2hex(random_bytes(32));"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dubairecovery
DB_USERNAME=root
DB_PASSWORD=

# Lead notification email (optional). Leads are always stored in the DB first.
MAIL_FROM=no-reply@dubaitowingexperts.com
MAIL_TO=

# Staging only: send X-Robots-Tag: noindex on every response
FORCE_NOINDEX=false
